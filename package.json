{
  "name": "@manageddotnet/signalr-client",
  "version": "0.1.0",
  "description": "TypeScript client for ManagedDotNet.SignalR.Topics — fluent topic bindings over Handle(topic, payload).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "signalr",
    "manageddotnet",
    "topic-hub",
    "typescript"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@microsoft/signalr": "^9.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0"
}
