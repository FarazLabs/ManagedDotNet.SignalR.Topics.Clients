{
  "name": "manageddotnet-topichub-client",
  "version": "0.1.6",
  "description": "TypeScript client for ManagedDotNet.SignalR.Topics — fluent topic bindings over Handle(topic, payload).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prelint": "pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:treeshake": "pnpm build && vitest run tests/dist/treeshake.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm test:dist && pnpm check:package",
    "prepublishOnly": "pnpm verify",
    "pack:release": "pnpm verify && pnpm pack",
    "test:dist": "pnpm build && vitest run tests/dist"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "signalr",
    "manageddotnet",
    "topic-hub",
    "typescript"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarazLabs/ManagedDotNet.SignalR.Topics.Clients.git"
  },
  "homepage": "https://github.com/FarazLabs/ManagedDotNet.SignalR.Topics.Clients",
  "bugs": {
    "url": "https://github.com/FarazLabs/ManagedDotNet.SignalR.Topics.Clients/issues"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.0 || ^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "rollup": "^4.64.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
